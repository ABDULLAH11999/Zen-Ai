# Gemini API Keys (Multi-Key Rotation: Supports primary + secondary backup keys)
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_backup_gemini_key_here
GEMINI_API_KEY_3=your_third_backup_gemini_key_here
GEMINI_MODEL=gemini-flash-latest

# Groq API Key (Ultra-Fast LPU Inference & Whisper-Large-v3-Turbo)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Owner & Master Identity
OWNER_NAME=Abdullah Irfan

# STT Model Configuration (High speed offline CPU/INT8)
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Audio & Wake Word Settings (ZEN, XZEN, ZZEN, ENN)
WAKE_WORDS=zen,hey zen,hi zen,xzen,hey xzen,zzen,hey zzen,enn,hey enn,x-zen,z-zen,ज़ेन,ज़ैन,زین,زن,ایکس زین
SAMPLE_RATE=16000
VAD_ENERGY_THRESHOLD=380
SILENCE_DURATION=0.8

# Language & Voice Mode
JARVIS_LANGUAGE=hindi

# TTS Voice Settings (Tony Stark Voice with deep -4Hz pitch)
TTS_VOICE_HINDI=hi-IN-MadhurNeural
TTS_VOICE_ENGLISH=en-GB-RyanNeural
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+5%
TTS_PITCH=-4Hz

# Vision Settings (High Speed)
SCREENSHOT_MAX_WIDTH=1280
SCREENSHOT_JPEG_QUALITY=70

# System Tools Sandboxing
ALLOWED_WORKING_DIR=f:/Agent
TERMINAL_COMMAND_TIMEOUT=45
